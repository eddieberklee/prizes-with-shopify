# Optional: Shopify Dev Dashboard Catalog API credentials for higher rate limits / scoped catalogs.
# Global Catalog (https://catalog.shopify.com/api/ucp/mcp) and Storefront UCP MCP
# (https://{shop}/api/ucp/mcp) work unauthenticated out of the box when these are omitted.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_CATALOG_ID=

# Optional: Custom UCP agent profile URI
SHOPIFY_UCP_AGENT_PROFILE=https://shopify.dev/ucp/agent-profiles/draft/valid-with-capabilities.json

# Optional: Default store domain when switching to single-storefront mode
NEXT_PUBLIC_DEFAULT_STORE_DOMAIN=3j6yup-ku.myshopify.com
